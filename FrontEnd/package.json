{
  "name": "smartbus-frontend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "cp -r assets/* public/assets/ && cp sw.js public/sw.js && vite build",
    "preview": "vite preview",
    "cap:sync": "npm run build && npx cap sync",
    "cap:open": "npx cap open android",
    "assets:generate": "npx @capacitor/assets generate --android --assetPath assets-source --iconBackgroundColor '#ffffff' --splashBackgroundColor '#ffffff'",
    "build:bundle": "npm run build && npx cap sync && cd android && ./gradlew bundleRelease"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capgo/capacitor-social-login": "^8.7.5"
  }
}
