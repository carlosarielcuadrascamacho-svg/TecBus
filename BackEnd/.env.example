# Copia este archivo como .env y completa los valores.
# Nunca subas el .env real al repositorio.

PORT=5000
NODE_ENV=development
MONGO_URI=
JWT_SECRET=
API_KEY_ESP32=

# Dominios del frontend separados por coma.
# Ejemplo: https://smartbus-mx.onrender.com,http://localhost:5500
CORS_ORIGINS=

# Web Push (VAPID)
MAILTO=mailto:admin@example.com
PUBLIC_VAPID_KEY=
PRIVATE_VAPID_KEY=

# Futuro: autenticación con Google
GOOGLE_CLIENT_ID=
ADMIN_EMAILS=
GOOGLE_ALLOWED_DOMAIN=
